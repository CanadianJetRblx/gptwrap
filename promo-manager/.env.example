# Panel access tokens. Use long random values (e.g. `openssl rand -hex 24`).
# ADMIN_TOKEN: full access. If unset, a temporary token is printed at startup.
ADMIN_TOKEN=
# EDITOR_TOKEN (optional): can manage content and schedules only.
EDITOR_TOKEN=

# Optional: token of YOUR Discord bot application, needed only for "bot channel"
# destinations. The bot must be invited to the partner server by its staff.
DISCORD_BOT_TOKEN=

# Where the panel listens. Keep 127.0.0.1 unless it sits behind a TLS reverse proxy.
HOST=127.0.0.1
PORT=8787

# Where the database and uploaded images are stored.
# DATA_DIR=./data
